# Copy to .streamlit/secrets.toml (never commit that file).
# On Streamlit Community Cloud paste the same keys into App settings > Secrets.

# Required. Supabase project settings > API. Use the anon (public) key only.
SUPABASE_URL = "https://your-project.supabase.co"
SUPABASE_ANON_KEY = "your-anon-public-key"

# Optional: AI photo tagging (falls back to colour detection without it).
GEMINI_API_KEY = ""
# GEMINI_MODEL = "gemini-flash-latest"

# Optional: open-ended AI stylist chat (falls back to rule-based replies).
OPENAI_API_KEY = ""
# OPENAI_MODEL = "gpt-5.4-mini"

# Optional: error tracking and log level.
SENTRY_DSN = ""
APP_ENV = "production"
LOG_LEVEL = "INFO"
